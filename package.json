{
  "name": "jiwnchoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm datagen && pnpm images && concurrently --kill-others \"next dev\" \"pnpm datagen --watch\"",
    "build": "pnpm datagen && pnpm images && next build",
    "typecheck": "pnpm datagen && pnpm images && next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install",
    "datagen": "node scripts/generate-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "images": "node scripts/generate-images.mjs"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@next/third-parties": "^16.3.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "katex": "^0.18.5",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-blog": "^4.6.1",
    "react": "^19.2.8",
    "react-devicons": "^2.16.2",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "daisyui": "^5.7.28",
    "js-yaml": "^5.4.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0"
}
